<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;netstandard2.1;netstandard2.0;net462;net35</TargetFrameworks>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>ImageRenderer.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RenderItems\Svg\**" />
    <EmbeddedResource Remove="RenderItems\Svg\**" />
    <None Remove="RenderItems\Svg\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\EPPlus\src\EPPlus\EPPlus.csproj" />
    <ProjectReference Include="..\EPPlus.Fonts.OpenType\EPPlus.Fonts.OpenType.csproj" />
    <ProjectReference Include="..\EPPlus.Graphics\EPPlus.Graphics.csproj" />
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="Core\Worksheet\Fonts\Tables\**" />
		<Compile Remove="FormulaParsing\Excel\Functions\DynamicArray\**" />
		<Compile Remove="FormulaParsing\FormulaExpressions\Variables\**" />
		<Compile Remove="Settings\**" />
		<Compile Remove="Utils\RecyclableMemoryStream\**" />
		<EmbeddedResource Remove="Core\Worksheet\Fonts\Tables\**" />
		<EmbeddedResource Remove="FormulaParsing\Excel\Functions\DynamicArray\**" />
		<EmbeddedResource Remove="FormulaParsing\FormulaExpressions\Variables\**" />
		<EmbeddedResource Remove="Settings\**" />
		<EmbeddedResource Remove="Utils\RecyclableMemoryStream\**" />
		<None Remove="Core\Worksheet\Fonts\Tables\**" />
		<None Remove="FormulaParsing\Excel\Functions\DynamicArray\**" />
		<None Remove="FormulaParsing\FormulaExpressions\Variables\**" />
		<None Remove="Settings\**" />
		<None Remove="Utils\RecyclableMemoryStream\**" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net35'">
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="System" />
		<Reference Include="System.configuration" />
		<Reference Include="System.Core" />
		<Reference Include="System.Data" />
		<Reference Include="System.Security" />
		<Reference Include="System.Xml" />
		<Reference Include="WindowsBase" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net462'">
		<Reference Include="PresentationCore" />
		<Reference Include="System" />
		<Reference Include="System.configuration" />
		<Reference Include="System.Core" />
		<Reference Include="System.Data" />
		<Reference Include="System.Security" />
		<Reference Include="System.Xml" />
		<Reference Include="System.Threading.Tasks" />
		<PackageReference Include="System.ComponentModel.Annotations" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
		<PackageReference Include="System.Security.Cryptography.Xml" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' != 'net35' and '$(TargetFramework)' != 'net462' and '$(TargetFramework)' != 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
		<PackageReference Include="System.ComponentModel.Annotations" />
		<PackageReference Include="System.Text.Encoding.CodePages" />
		<PackageReference Include="System.Security.Cryptography.Xml" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" VersionOverride="9.0.3" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" VersionOverride="9.0.3" />
		<PackageReference Include="System.ComponentModel.Annotations" />
		<PackageReference Include="System.Text.Encoding.CodePages" VersionOverride="9.0.3" />
		<PackageReference Include="System.Security.Cryptography.Xml" VersionOverride="9.0.3" />
	</ItemGroup>

  <ItemGroup>
    <None Update="Adjustments\ActionButtonBackPrevious.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\ActionButtonBeginning.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\ActionButtonDocument.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\ActionButtonHelp.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\Donut.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\DownArrow.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\LeftArrow.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\RightArrow.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\Trapezoid.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\Triangle.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Adjustments\UpArrow.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="resource\presetShapeDefinitions.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
